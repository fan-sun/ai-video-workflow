{
  "name": "ai-video-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 辅助的教学与概念讲解视频制作流程",
  "engines": { "node": ">=22.9.0" },
  "scripts": {
    "workbench": "node workbench/server.mjs",
    "test": "node --env-file-if-exists=.env --test tests/node/*.test.mjs",
    "test:python": "node --env-file-if-exists=.env build/common/run_python.mjs -m unittest discover -s tests",
    "voiceover": "node --env-file-if-exists=.env build/common/run_python.mjs pipeline/02_audio/voxcpm_tts.py",
    "init:episode": "node --env-file-if-exists=.env build/common/init_course_episode.mjs",
    "teaching:init": "node --env-file-if-exists=.env build/common/route_command.mjs course init",
    "teaching:review": "node --env-file-if-exists=.env build/common/route_command.mjs course review",
    "teaching:publish": "node --env-file-if-exists=.env build/common/route_command.mjs course publish",
    "teaching:check-release": "node --env-file-if-exists=.env build/common/route_command.mjs course check-release",
    "vibe:init": "node --env-file-if-exists=.env build/common/route_command.mjs vibe init",
    "vibe:review": "node --env-file-if-exists=.env build/common/route_command.mjs vibe review",
    "vibe:publish": "node --env-file-if-exists=.env build/common/route_command.mjs vibe publish",
    "vibe:check-release": "node --env-file-if-exists=.env build/common/route_command.mjs vibe check-release",
    "vibe:mix": "node --env-file-if-exists=.env build/vibe/mix_video_audio.mjs",
    "vibe:preview-music": "node build/vibe/preview_video_audio.mjs",
    "topic:check": "node --env-file-if-exists=.env build/common/check_course_topic_duplicate.mjs",
    "review": "node --env-file-if-exists=.env build/common/route_command.mjs auto review",
    "publish:package": "node --env-file-if-exists=.env build/common/route_command.mjs auto publish",
    "check:release": "node --env-file-if-exists=.env build/common/check_course_release.mjs",
    "doctor": "node --env-file-if-exists=.env build/common/doctor.mjs",
    "timeline:vibe": "node build/vibe/vibe_timeline.mjs",
    "split:vibe": "node build/vibe/vibe_caption_split.mjs",
    "mix": "node --env-file-if-exists=.env build/vibe/mix_video_audio.mjs",
    "preview:music": "node build/vibe/preview_video_audio.mjs",
    "preview:motion": "node examples/vibe-motion/run.mjs serve",
    "preview:styles": "node examples/vibe-styles/run.mjs serve",
    "example:vibe": "node --env-file-if-exists=.env examples/vibe-knowledge/run.mjs",
    "example": "node --env-file-if-exists=.env examples/context-window/run.mjs"
  }
}
