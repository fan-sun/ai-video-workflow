# Node 配置由 npm 脚本自动读取；Python 配音命令见安装说明。
# 模型目录、参考声音及精确配对文本由使用者准备。
VOXCPM_MODEL=models/VoxCPM2
VOXCPM_SRC=
VOXCPM_REF_WAV=voices/reference.wav
VOXCPM_REF_TEXT_FILE=voices/reference.txt
# Python 使用本机 VoxCPM 环境解释器；留空字段请删除或填写。
COURSE_PYTHON=python
# 默认根据 git --exec-path 定位 Git Bash，特殊安装可显式填写。
# COURSE_GIT_BASH=C:/Program Files/Git/bin/bash.exe
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# COURSE_COVER_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# 可选：语义相关提醒；不填写时只执行精确查重和 BM25，并明确提示。
SILICONFLOW_API_KEY=
